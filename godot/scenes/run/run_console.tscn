[gd_scene format=3]

[node name="UiRoot" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "运行台 · 月度绩效"

[node name="Split" type="VSplitContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 230

[node name="ControlsBox" type="VBoxContainer" parent="Margin/VBox/Split"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SchemeRow" type="HBoxContainer" parent="Margin/VBox/Split/ControlsBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SchemeLabel" type="Label" parent="Margin/VBox/Split/ControlsBox/SchemeRow"]
layout_mode = 2
text = "方案："

[node name="SchemeSelect" type="OptionButton" parent="Margin/VBox/Split/ControlsBox/SchemeRow"]
layout_mode = 3
size_flags_horizontal = 3

[node name="MonthRow" type="HBoxContainer" parent="Margin/VBox/Split/ControlsBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="MonthLabel" type="Label" parent="Margin/VBox/Split/ControlsBox/MonthRow"]
layout_mode = 2
text = "月份目录："

[node name="MonthDirLabel" type="Label" parent="Margin/VBox/Split/ControlsBox/MonthRow"]
layout_mode = 3
size_flags_horizontal = 3
text = "（未选择）"
clip_text = true
tooltip_text = "当前月份台账目录"

[node name="MonthPickBtn" type="Button" parent="Margin/VBox/Split/ControlsBox/MonthRow"]
layout_mode = 2
text = "选择…"

[node name="ActionRow" type="HBoxContainer" parent="Margin/VBox/Split/ControlsBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ValidateBtn" type="Button" parent="Margin/VBox/Split/ControlsBox/ActionRow"]
layout_mode = 2
text = "校验方案"

[node name="DryRunBtn" type="Button" parent="Margin/VBox/Split/ControlsBox/ActionRow"]
layout_mode = 2
text = "Dry-run 预览"

[node name="RunBtn" type="Button" parent="Margin/VBox/Split/ControlsBox/ActionRow"]
layout_mode = 2
text = "实际运行（写回+.bak）"

[node name="LogPanel" type="PanelContainer" parent="Margin/VBox/Split"]
layout_mode = 2
size_flags_vertical = 3

[node name="Log" type="RichTextLabel" parent="Margin/VBox/Split/LogPanel"]
layout_mode = 2
scroll_following = true

[node name="MonthDirDialog" type="FileDialog" parent="."]
title = "选择月份台账目录"
initial_position = 1
access = 2
size = Vector2i(760, 520)
file_mode = 2
