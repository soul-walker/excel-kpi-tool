theme_override_constants/separation = 4

[node name="派生" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="DerivedHintRow" type="HBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生"]
layout_mode = 2

