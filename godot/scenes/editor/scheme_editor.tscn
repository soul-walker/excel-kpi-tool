[gd_scene format=3]

[node name="EditorRoot" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Toolbar" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SchemeLabel" type="Label" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "方案："

[node name="SchemeSelect" type="OptionButton" parent="Margin/VBox/Toolbar"]
layout_mode = 3
size_flags_horizontal = 3

[node name="NewBtn" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "新建方案"

[node name="LoadBtn" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "载入"

[node name="SaveBtn" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "保存"

[node name="ValidateBtn" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "校验"

[node name="MetaLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
autowrap_mode = 2
text = "（未载入方案）"

[node name="InfoBox" type="VBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="NameRow" type="HBoxContainer" parent="Margin/VBox/InfoBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="NameLabel" type="Label" parent="Margin/VBox/InfoBox/NameRow"]
layout_mode = 2
custom_minimum_size = Vector2(56, 0)
text = "名称："

[node name="NameEdit" type="LineEdit" parent="Margin/VBox/InfoBox/NameRow"]
layout_mode = 3
size_flags_horizontal = 3
placeholder_text = "方案名称（保存时作为文件名，如 绩效-2026-09）"
tooltip_text = "保存时按此名称在 schemes/ 目录生成同名 .json 文件；改名保存将同时重命名文件"

[node name="DescRow" type="HBoxContainer" parent="Margin/VBox/InfoBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="DescLabel" type="Label" parent="Margin/VBox/InfoBox/DescRow"]
layout_mode = 2
custom_minimum_size = Vector2(56, 0)
text = "描述："

[node name="DescEdit" type="LineEdit" parent="Margin/VBox/InfoBox/DescRow"]
layout_mode = 3
size_flags_horizontal = 3
placeholder_text = "用途 / 说明（可选）"

[node name="Split" type="HSplitContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 660

[node name="ParamsPanel" type="PanelContainer" parent="Margin/VBox/Split"]
layout_mode = 2

[node name="ParamsVBox" type="VBoxContainer" parent="Margin/VBox/Split/ParamsPanel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="ParamsTitleRow" type="HBoxContainer" parent="Margin/VBox/Split/ParamsPanel/ParamsVBox"]
layout_mode = 2

[node name="ParamsTitle" type="Label" parent="Margin/VBox/Split/ParamsPanel/ParamsVBox/ParamsTitleRow"]
layout_mode = 2
text = "参数（默认整数，填值自动识别类型；可手动指定，保存后写回）"
size_flags_horizontal = 3

[node name="AddParamBtn" type="Button" parent="Margin/VBox/Split/ParamsPanel/ParamsVBox/ParamsTitleRow"]
layout_mode = 2
text = "+ 新增参数"

[node name="ParamsScroll" type="ScrollContainer" parent="Margin/VBox/Split/ParamsPanel/ParamsVBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="ParamsBox" type="VBoxContainer" parent="Margin/VBox/Split/ParamsPanel/ParamsVBox/ParamsScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="LogPanel" type="PanelContainer" parent="Margin/VBox/Split"]
layout_mode = 2

[node name="Log" type="RichTextLabel" parent="Margin/VBox/Split/LogPanel"]
layout_mode = 2
bbcode_enabled = true
scroll_following = true
