[gd_scene format=3]

[node name="EditorRoot" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Toolbar" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SchemeLabel" type="Label" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "方案："

[node name="SchemeSelect" type="OptionButton" parent="Margin/VBox/Toolbar"]
layout_mode = 3
size_flags_horizontal = 3

[node name="NewBtn" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "新建方案"

[node name="LoadBtn" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "载入"

[node name="SaveBtn" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "保存"

[node name="ValidateBtn" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "校验"

[node name="InfoBox" type="VBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="NameRow" type="HBoxContainer" parent="Margin/VBox/InfoBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="NameLabel" type="Label" parent="Margin/VBox/InfoBox/NameRow"]
layout_mode = 2
custom_minimum_size = Vector2(56, 0)
text = "名称："

[node name="NameEdit" type="LineEdit" parent="Margin/VBox/InfoBox/NameRow"]
layout_mode = 3
size_flags_horizontal = 3
placeholder_text = "方案名称（保存时作为文件名，如 绩效-2026-09）"
tooltip_text = "保存时按此名称在 schemes/ 目录生成同名 .json 文件；改名保存将同时重命名文件"

[node name="DescRow" type="HBoxContainer" parent="Margin/VBox/InfoBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="DescLabel" type="Label" parent="Margin/VBox/InfoBox/DescRow"]
layout_mode = 2
custom_minimum_size = Vector2(56, 0)
text = "描述："

[node name="DescEdit" type="LineEdit" parent="Margin/VBox/InfoBox/DescRow"]
layout_mode = 3
size_flags_horizontal = 3
placeholder_text = "用途 / 说明（可选）"

[node name="Split" type="HSplitContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 660

[node name="LeftPanel" type="PanelContainer" parent="Margin/VBox/Split"]
layout_mode = 2

[node name="LeftVBox" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Tabs" type="TabContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="参数" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="ParamsTitleRow" type="HBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/参数"]
layout_mode = 2

[node name="ParamsTitle" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/参数/ParamsTitleRow"]
layout_mode = 2
text = "参数（默认整数，填值自动识别类型；可手动指定，保存后写回）"
size_flags_horizontal = 3

[node name="AddParamBtn" type="Button" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/参数/ParamsTitleRow"]
layout_mode = 2
text = "+ 新增参数"

[node name="ParamsScroll" type="ScrollContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/参数"]
layout_mode = 2
size_flags_vertical = 3

[node name="ParamsBox" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/参数/ParamsScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="数据源" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="SourcesTitleRow" type="HBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/数据源"]
layout_mode = 2

[node name="SourcesHint" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/数据源/SourcesTitleRow"]
layout_mode = 2
text = "数据源（Excel 台账）：每个数据源一行，点「列映射」编辑该源的读取列"
size_flags_horizontal = 3
autowrap_mode = 2

[node name="AddSourceBtn" type="Button" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/数据源/SourcesTitleRow"]
layout_mode = 2
text = "+ 新增数据源"

[node name="SourcesScroll" type="ScrollContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/数据源"]
layout_mode = 2
size_flags_vertical = 3

[node name="SourcesBox" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/数据源/SourcesScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="ColsTitleRow" type="HBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/数据源"]
layout_mode = 2

[node name="ColsTitle" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/数据源/ColsTitleRow"]
layout_mode = 2
text = "列映射"
size_flags_horizontal = 3

[node name="AddColBtn" type="Button" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/数据源/ColsTitleRow"]
layout_mode = 2
text = "+ 新增列"

[node name="ColsScroll" type="ScrollContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/数据源"]
layout_mode = 2
size_flags_vertical = 3

[node name="ColsBox" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/数据源/ColsScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="派生" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="DerivedHintRow" type="HBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生"]
layout_mode = 2

[node name="DerivedHint" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DerivedHintRow"]
layout_mode = 2
text = "派生视图：从已读表生成新视角（如把\"替上课老师\"列升为主键的代课视角）。点行尾「详情」编辑该派生。"
size_flags_horizontal = 3
autowrap_mode = 2

[node name="AddDerivedBtn" type="Button" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DerivedHintRow"]
layout_mode = 2
text = "+ 新增派生"

[node name="DerivedScroll" type="ScrollContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生"]
layout_mode = 2

[node name="DerivedBox" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DerivedScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="DetailScroll" type="ScrollContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生"]
layout_mode = 2
size_flags_vertical = 3

[node name="DetailVBox" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="DetailTitle" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox"]
layout_mode = 2
autowrap_mode = 2
text = "派生详情（未选中派生）"

[node name="IdRow" type="HBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="IdLabel" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/IdRow"]
layout_mode = 2
custom_minimum_size = Vector2(96, 0)
text = "派生 id："

[node name="DerivedIdEdit" type="LineEdit" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/IdRow"]
layout_mode = 3
size_flags_horizontal = 3
placeholder_text = "如 代课视角（其它引用按此 id 指向本视图）"

[node name="FromRow" type="HBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="FromLabel" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/FromRow"]
layout_mode = 2
custom_minimum_size = Vector2(96, 0)
text = "来源表 from："

[node name="FromSelect" type="OptionButton" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/FromRow"]
layout_mode = 3
size_flags_horizontal = 3

[node name="MergeRow" type="HBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="MergeLabel" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/MergeRow"]
layout_mode = 2
custom_minimum_size = Vector2(96, 0)
text = "合并续列 on："

[node name="MergeEdit" type="LineEdit" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/MergeRow"]
layout_mode = 3
size_flags_horizontal = 3
placeholder_text = "留空=不合并；填列名（如 天数）：该列空的续行并入上一条记录"

[node name="WhenRow" type="HBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="WhenLabel" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/WhenRow"]
layout_mode = 2
custom_minimum_size = Vector2(96, 0)
text = "过滤 when："

[node name="WhenEdit" type="LineEdit" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/WhenRow"]
layout_mode = 3
size_flags_horizontal = 3
placeholder_text = "留空=全部行；如 替上课老师 != ''（只留被他人代课的行）"

[node name="GroupRow" type="HBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="GroupLabel" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/GroupRow"]
layout_mode = 2
custom_minimum_size = Vector2(96, 0)
text = "分组列："

tooltip_text = "按哪一列归并成一条后再算字段（如按 姓名 汇总每个老师）；留空则每行各算一条"

[node name="GroupEdit" type="LineEdit" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/GroupRow"]
layout_mode = 3
size_flags_horizontal = 3
placeholder_text = "空 = 逐行；填列名 = 按该列归并后再算下方字段（字段可写 SUM(列)）"

[node name="FieldHead" type="HBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox"]
layout_mode = 2

[node name="FieldTitle" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/FieldHead"]
layout_mode = 2
text = "视图列定义（列名 = 表达式；写源列名即映射/改名；expr 空 = 同名透传）"
size_flags_horizontal = 3

[node name="AddFieldBtn" type="Button" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox/FieldHead"]
layout_mode = 2
text = "+ 视图列"

[node name="FieldBox" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/派生/DetailScroll/DetailVBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="规划" type="VBoxContainer" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs"]
layout_mode = 2

[node name="PlanHint" type="Label" parent="Margin/VBox/Split/LeftPanel/LeftVBox/Tabs/规划"]
layout_mode = 2
autowrap_mode = 2
text = "聚合指标 / 计算分组 / 输出 编辑：后续迭代"

[node name="LogPanel" type="PanelContainer" parent="Margin/VBox/Split"]
layout_mode = 2

[node name="Log" type="RichTextLabel" parent="Margin/VBox/Split/LogPanel"]
layout_mode = 2
scroll_following = true
