[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../target/debug/libkpi_tool.so"
linux.release.x86_64 = "res://../target/release/libkpi_tool.so"
windows.debug.x86_64 = "res://../target/debug/kpi_tool.dll"
windows.release.x86_64 = "res://../target/release/kpi_tool.dll"
macos.debug = "res://../target/debug/libkpi_tool.dylib"
macos.release = "res://../target/release/libkpi_tool.dylib"
macos.debug.arm64 = "res://../target/debug/libkpi_tool.dylib"
macos.release.arm64 = "res://../target/release/libkpi_tool.dylib"
