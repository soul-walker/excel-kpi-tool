{
  "schema_version": 1,
  "scheme": {
    "name": "高中月绩效（复刻 school-kpi）",
    "description": "M0 样例：演示如何把老程序语义表达为一份方案。表达式语义求值待 M1（calc DSL）；本文件用于 schema 加载/校验回归。",
    "entity": {
      "key_field": "姓名",
      "duplicate": "report"
    },
    "parameters": [
      { "name": "考勤奖", "label": "考勤奖", "value_type": "integer", "value": 100 },
      { "name": "基础课时", "label": "基础课时", "value_type": "decimal", "value": 15.6 },
      { "name": "课时费", "label": "课时费", "value_type": "decimal", "value": 1.5 },
      { "name": "超课时费", "label": "超课时费", "value_type": "decimal", "value": 5 },
      { "name": "补课时费", "label": "补课时费", "value_type": "decimal", "value": 7 },
      { "name": "事假单价", "label": "事假单价", "value_type": "decimal", "value": 20 },
      { "name": "病假单价", "label": "病假单价", "value_type": "decimal", "value": 10 },
      { "name": "折扣", "label": "折扣", "value_type": "decimal", "value": 0.2 },
      { "name": "请假超过天数", "label": "请假超过天数", "value_type": "integer", "value": 20 }
    ],
    "sources": [
      {
        "id": "keshi",
        "file": "课时.xlsx",
        "sheet": "课时",
        "header_row": 1,
        "parse": {},
        "columns": [
          { "header": "姓名", "alias": "姓名", "value_type": "text", "key": true },
          { "header": "总计", "alias": "课时", "value_type": "decimal", "required": true }
        ]
      },
      {
        "id": "gangwei",
        "file": "岗位.xlsx",
        "sheet": "Sheet1",
        "header_row": 1,
        "parse": {},
        "columns": [
          { "header": "姓名", "alias": "姓名", "value_type": "text", "key": true },
          { "header": "岗位奖", "alias": "岗位奖", "value_type": "integer" },
          { "header": "教研组长", "alias": "教研组长", "value_type": "integer" },
          { "header": "年级组长", "alias": "年级组长", "value_type": "integer" },
          { "header": "行政后勤", "alias": "行政后勤", "value_type": "integer" },
          { "header": "行、后", "alias": "行后", "value_type": "integer" }
        ]
      },
      {
        "id": "qingjia",
        "file": "请假替上课.xlsx",
        "sheet": "请假替上课",
        "header_row": 1,
        "parse": {
          "fill_down": ["姓名"],
          "continue_record_on": ["天数"]
        },
        "columns": [
          { "header": "姓名", "alias": "姓名", "value_type": "text", "key": true },
          { "header": "类型", "alias": "类型", "value_type": "text" },
          { "header": "天数", "alias": "天数", "value_type": "decimal" },
          { "header": "替上课老师", "alias": "替上课老师", "value_type": "text" },
          { "header": "节数", "alias": "节数", "value_type": "integer" }
        ]
      }
    ],
    "derived": [
      {
        "id": "bukei",
        "from": "qingjia",
        "where": "qingjia.替上课老师 != ''",
        "columns": [
          { "name": "姓名", "expr": "GROUP_BY(qingjia.替上课老师)" },
          { "name": "节数", "expr": "SUM(qingjia.节数)" },
          { "name": "费用", "expr": "bukei.节数 * 参数.补课时费" }
        ]
      }
    ],
    "aggregates": [
      { "id": "请假超总天数", "from": "qingjia", "group_by": "姓名", "where": "qingjia.类型 != '公'", "expr": "SUM(qingjia.天数)" },
      { "id": "请假超额", "from": "qingjia", "group_by": "姓名", "expr": "聚合.请假超总天数 >= 参数.请假超过天数" }
    ],
    "groups": [
      {
        "id": "fxp",
        "name": "非校聘",
        "match_sheet": "非校聘",
        "fields": [
          { "name": "课时S", "expr": "if 聚合.请假超额 { 0 } else { keshi.课时 ?? 0 }" },
          { "name": "课时X", "expr": "if 聚合.请假超额 { 0 } else { MAX(0, 课时S - 参数.基础课时) }" },
          { "name": "课时费S", "expr": "if 聚合.请假超额 { 0 } else { 课时S * 参数.课时费 }" },
          { "name": "课时费X", "expr": "if 聚合.请假超额 { 0 } else { 课时X * 参数.超课时费 }" },
          { "name": "课时周费", "expr": "课时费S + 课时费X" },
          { "name": "课时月费", "expr": "课时周费 * 4" },
          { "name": "考勤奖", "expr": "if 聚合.请假超额 { 0 } else { 参数.考勤奖 }" },
          { "name": "合计1", "expr": "课时月费 + 考勤奖" },
          { "name": "合计2", "expr": "(班主任 + 教研组长 + 年级组长 + 行政后勤 + 行后) * 0.4" },
          { "name": "合计", "expr": "合计1 + 合计2" },
          { "name": "上浮30%", "expr": "合计 * 1.3" },
          { "name": "实际发放", "expr": "ROUND(上浮30%, 0)" }
        ],
        "overrides": []
      },
      {
        "id": "xp",
        "name": "校聘",
        "match_sheet": "校聘",
        "fields": [],
        "overrides": [
          { "name": "合计2", "expr": "(班主任 + 教研组长 + 年级组长 + 行政后勤 + 行后) * 1" },
          { "name": "上浮30%", "expr": null },
          { "name": "实际发放", "expr": "ROUND(合计, 0)" }
        ]
      }
    ],
    "outputs": [
      {
        "id": "jx",
        "kind": {
          "patch_template": {
            "file": "绩效.xlsx",
            "apply": "inplace",
            "backup": true,
            "dry_run": true,
            "row_key": "姓名",
            "groups": [
              { "group": "fxp", "sheet": "非校聘" },
              { "group": "xp", "sheet": "校聘" }
            ],
            "columns": [
              { "field": "课时S", "header": "课时S", "num_fmt": "0.00", "blank": "blank" },
              { "field": "课时X", "header": "课时X", "num_fmt": "0.00", "blank": "blank" },
              { "field": "课时费S", "header": "课时费S", "num_fmt": "0.00", "blank": "blank" },
              { "field": "课时费X", "header": "课时费X", "num_fmt": "0.00", "blank": "blank" },
              { "field": "课时周费", "header": "课时周费", "num_fmt": "0.00", "blank": "blank" },
              { "field": "课时月费", "header": "课时月费", "num_fmt": "0.00", "blank": "blank" },
              { "field": "考勤奖", "header": "考勤奖", "num_fmt": "0", "blank": "blank" },
              { "field": "实际发放", "header": "实际发放", "num_fmt": "0", "blank": "blank" }
            ]
          }
        }
      },
      {
        "id": "bks",
        "kind": {
          "new_file": {
            "file": "补课时.xlsx",
            "from": "bukei",
            "sheet": "替上课补课时",
            "columns": [
              { "header": "姓名", "field": "姓名" },
              { "header": "节数", "field": "节数" },
              { "header": "费用", "field": "费用" }
            ]
          }
        }
      }
    ]
  }
}
